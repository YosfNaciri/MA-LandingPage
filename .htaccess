# ==========================================
# MA-LandingPage - React + Vite
# Cloudways Hybrid Stack
# ==========================================

Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve existing files and directories normally
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Send all other requests to React
    RewriteRule ^ index.html [L]
</IfModule>

# ==========================================
# Browser Cache
# ==========================================

<IfModule mod_headers.c>

    # Always revalidate HTML
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

</IfModule>

# ==========================================
# Security
# ==========================================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Keep confirmation routes accessible to clients but out of search results.
# THE_REQUEST preserves the original path through the SPA rewrite to index.html.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, follow" "expr=%{THE_REQUEST} =~ m#\s/+((confirm-client|confirmation-client)(/|[?\s]))#"
</IfModule>
